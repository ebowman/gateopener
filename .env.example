# App Store Connect API key credentials for testflight.sh.
# Copy this file to .env (gitignored) and fill in the values.
#
# The .p8 private key file itself is NOT stored here — it must exist at:
#   ~/.appstoreconnect/private_keys/AuthKey_<API_KEY_ID>.p8
#
# Generate/download a key at:
#   https://appstoreconnect.apple.com/access/integrations/api

API_KEY_ID=
API_ISSUER_ID=
